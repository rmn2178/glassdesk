---
import { Font } from "astro:assets";
import IconSprite from "@/components/ui/IconSprite.astro";
import { author, organization, site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Error pages: keep them out of the index and skip the product schema. */
  noindex?: boolean;
  /** The product schema describes the app, so only the home page carries it. */
  product?: boolean;
  /** Extra JSON-LD nodes for this page, joined into the site graph. */
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, product = true, schema: pageSchema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImage = site.ogImage ? new URL(site.ogImage, site.url).href : null;

const home = new URL("/", site.url).href;

const person = {
  "@type": "Person",
  "@id": author.id,
  name: author.name,
  alternateName: author.shortName,
  jobTitle: author.role,
  url: author.profile,
  homeLocation: { "@type": "Place", name: author.location },
  sameAs: [author.github, author.x, author.linkedin, author.website],
  memberOf: { "@id": organization.id },
};

const publisher = {
  "@type": "Organization",
  "@id": organization.id,
  name: organization.name,
  url: organization.url,
  description: organization.description,
  sameAs: [organization.github],
};

const website = {
  "@type": "WebSite",
  "@id": `${home}#website`,
  name: site.name,
  url: home,
  inLanguage: "en",
  author: { "@id": author.id },
  publisher: { "@id": organization.id },
};

// Lets Google show the product as an app result: name, price, platform, source.
const app = !product
  ? null
  : {
      "@type": "SoftwareApplication",
      "@id": `${home}#app`,
      name: site.name,
      applicationCategory: "UtilitiesApplication",
      applicationSubCategory: "Desktop enhancement",
      operatingSystem: "Windows 10, Windows 11",
      softwareRequirements: "Windows 10 version 1903 or later, or Windows 11; 64-bit",
      description: site.description,
      url: home,
      downloadUrl: site.download,
      softwareVersion: site.version,
      license: `${site.repository}/blob/main/LICENSE`,
      codeRepository: site.repository,
      isPartOf: { "@id": `${home}#website` },
      author: { "@id": author.id },
      publisher: { "@id": organization.id },
      maintainer: { "@id": author.id },
      inLanguage: "en",
      isAccessibleForFree: true,
      featureList: [
        "Icons that grow under the cursor",
        "Minimized windows as live thumbnails",
        "Drag files onto apps",
        "Optional top menu bar",
        "Restores the Windows taskbar when the dock stops",
        "AI plan usage for Claude Code, Codex, OpenCode Go, Gemini CLI and Antigravity",
        "Gemini Pro and Flash quota windows when available",
        "Event-driven mascot reactions to AI limits and power events",
        "Genie minimize effect",
      ],
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      ...(ogImage && { screenshot: ogImage }),
    };

const schema = noindex
  ? null
  : {
      "@context": "https://schema.org",
      "@graph": [website, person, publisher, ...(app ? [app] : []), ...pageSchema],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="google-site-verification" content="MNGdMnCWivH5Bkg6WwcT-K_uSRLYkw1-dVJltkWgFPc" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:secure_url" content={ogImage} />
          <meta property="og:image:width" content={String(site.ogImageWidth)} />
          <meta property="og:image:height" content={String(site.ogImageHeight)} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:alt" content={`${site.name} - ${site.tagline}`} />
        </>
      )
    }

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:creator" content={site.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <>
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={`${site.name} - ${site.tagline}`} />
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.webp" type="image/webp" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#f5f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e0f" media="(prefers-color-scheme: dark)" />

    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:squircle-pill focus:bg-primary-gradient focus:px-4 focus:py-2 focus:font-bold focus:text-ink"
    >
      Skip to content
    </a>
    <IconSprite />
    <slot />
  </body>
</html>
