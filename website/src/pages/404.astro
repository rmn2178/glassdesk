---
import Container from "@/components/layout/Container.astro";
import Button from "@/components/ui/Button.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found - Muelle"
  description="This page does not exist. Go back to the Muelle home page."
  noindex
>
  <main id="main" class="flex min-h-screen items-center">
    <Container class="text-center">
      <p class="font-mono text-[11px] tracking-[0.08em] text-mute uppercase">404</p>
      <h1 class="mt-3 text-[clamp(2rem,5vw,3.5rem)]">This page left the dock.</h1>
      <p class="mx-auto mt-4 max-w-md text-mute">
        The link is broken or the page moved. Everything about Muelle is on the home page.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href="/">Back to Muelle</Button>
      </div>
    </Container>
  </main>
</BaseLayout>
