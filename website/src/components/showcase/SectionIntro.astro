---
/** Centered opening of a section, the way Apple product pages introduce a feature. */
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

<header class:list={["intro", className]} data-r>
  <p class="intro-eyebrow">{eyebrow}</p>
  <h2 class="intro-title">{title}</h2>
  <p class="intro-lead">{lead}</p>
</header>
