---
import { Image } from "astro:assets";
import wallpaper from "@/assets/wallpapers/desktop-02.jpg";
import Section from "@/components/layout/Section.astro";
import SectionIntro from "@/components/showcase/SectionIntro.astro";
import MenuBarStatus from "@/components/dock/MenuBarStatus.astro";
import SettingsIcon from "@/components/showcase/SettingsIcon.astro";
import ToggleRow from "@/components/showcase/ToggleRow.astro";
import Crab from "@/components/crab/Crab.astro";
import {
  customizeIntro,
  previewDockItems,
  settingsDefaults as d,
  settingsText,
  settingsLanguages,
  type SettingsKey,
} from "@/data/showcase";
import "@/styles/showcase.css";

const t = settingsText.en;
const tx = (key: SettingsKey) => ({ "data-t": key });
const checked = (on: boolean) => (on ? "true" : "false");
/** The sections of the Settings app, in its order. */
const panes = ["dock", "windows", "menubar", "system"] as const;
// `<` is escaped so no text can ever close the script tag early.
const textJson = JSON.stringify(settingsText).replace(/</g, "\\u003c");
---

<Section id="customize">
  <SectionIntro {...customizeIntro} />

  <div class="custom" data-customize data-r>
    <div class="mac-window settings" role="group" aria-label={t.title} data-label="title">
      <aside class="settings-side">
        <div class="mac-lights" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <nav class="settings-nav">
          {panes.map((pane, index) => (
            <button
              type="button"
              data-pane={pane}
              data-label={pane}
              aria-current={index === 0 ? "page" : undefined}
              aria-label={t[pane]}
            >
              <SettingsIcon section={pane} />
              <span class="settings-nav-label" {...tx(pane)}>
                {t[pane]}
              </span>
            </button>
          ))}
        </nav>
      </aside>

      <div class="settings-main">
        <p class="settings-title" data-pane-title>
          {t.dock}
        </p>

        <div class="settings-body" data-view="dock">
          <div class="settings-card">
            <div class="settings-row">
              <span class="settings-label" {...tx("size")}>
                {t.size}
              </span>
              <span class="mac-range-wrap">
                <small {...tx("small")}>{t.small}</small>
                <input
                  type="range"
                  class="mac-range"
                  aria-label={t.size}
                  data-setting="iconSize"
                  data-label="size"
                  min={d.iconSizeMin}
                  max={d.iconSizeMax}
                  value={d.iconSize}
                />
                <small {...tx("large")}>{t.large}</small>
              </span>
            </div>
            <div class="settings-row">
              <label class="settings-label" for="preview-density" {...tx("dockDensity")}>
                {t.dockDensity}
              </label>
              <select
                id="preview-density"
                class="mac-select"
                data-setting="dockDensity"
                data-label="dockDensity"
              >
                {(["compact", "normal", "spacious"] as const).map((choice) => (
                  <option value={choice} selected={choice === d.dockDensity} {...tx(choice)}>
                    {t[choice]}
                  </option>
                ))}
              </select>
            </div>
            <div class="settings-row">
              <span class="settings-text">
                <span class="settings-label" {...tx("magnification")}>
                  {t.magnification}
                </span>
                <span class="settings-hint" {...tx("magnificationHint")}>
                  {t.magnificationHint}
                </span>
              </span>
              <button
                type="button"
                role="switch"
                class="mac-switch"
                aria-checked={checked(d.magnification)}
                aria-label={t.magnification}
                data-setting="magnification"
              >
                <i></i>
              </button>
            </div>
            <div class="settings-row">
              <span class="settings-label" {...tx("magnifiedSize")}>
                {t.magnifiedSize}
              </span>
              <span class="mac-range-wrap">
                <small {...tx("small")}>{t.small}</small>
                <input
                  type="range"
                  class="mac-range"
                  aria-label={t.magnifiedSize}
                  data-setting="magnifiedSize"
                  min={d.iconSize}
                  max={d.magnifiedSizeMax}
                  value={d.magnifiedSize}
                />
                <small {...tx("large")}>{t.large}</small>
              </span>
            </div>
          </div>

          <div class="settings-card">
            <ToggleRow name="autoHide" hint="autoHideHint" on={d.autoHide} />
            <div class="settings-row" data-speed-row hidden>
              <label class="settings-label" for="preview-hide-speed" {...tx("dockAutoHideSpeed")}>
                {t.dockAutoHideSpeed}
              </label>
              <select
                id="preview-hide-speed"
                class="mac-select"
                data-setting="dockAutoHideSpeed"
                data-label="dockAutoHideSpeed"
              >
                {(["smooth", "normal", "fast"] as const).map((choice) => (
                  <option value={choice} selected={choice === d.dockAutoHideSpeed} {...tx(choice)}>
                    {t[choice]}
                  </option>
                ))}
              </select>
            </div>
            <ToggleRow name="mascot" hint="mascotHint" on={d.mascot} />
          </div>
          <details class="settings-card settings-details">
            <summary {...tx("fixedItems")}>{t.fixedItems}</summary>
            <ToggleRow name="showStart" on={d.showStart} />
            <ToggleRow name="pinExplorer" hint="pinExplorerHint" on={d.pinExplorer} />
            <ToggleRow name="showDownloads" on={d.showDownloads} />
            <ToggleRow name="showTrash" on={d.showTrash} />
            <p class="settings-hint settings-note" {...tx("fixedItemsHint")}>
              {t.fixedItemsHint}
            </p>
          </details>
        </div>

        <div class="settings-body" data-view="windows" hidden>
          <div class="settings-card">
            <ToggleRow name="genie" hint="genieHint" on={d.genie} />
            <ToggleRow name="showMinimized" hint="showMinimizedHint" on={d.showMinimized} />
          </div>
        </div>

        <div class="settings-body" data-view="menubar" hidden>
          <div class="settings-card">
            <ToggleRow name="menuBar" hint="menuBarHint" on={d.menuBar} />
            <ToggleRow
              name="menuBarAutoHide"
              hint="menuBarAutoHideHint"
              on={d.menuBarAutoHide}
              sub
            />
            <ToggleRow name="aiUsage" hint="aiUsageHint" on={d.aiUsage} sub />
            <ToggleRow
              name="accessoryBattery"
              hint="accessoryBatteryHint"
              on={d.accessoryBattery}
              sub
            />
          </div>
          <p class="settings-hint" {...tx("accessoryPreviewHint")}>
            {t.accessoryPreviewHint}
          </p>
        </div>

        <div class="settings-body" data-view="system" hidden>
          <div class="settings-card">
            <div class="settings-row">
              <span class="settings-label" {...tx("autostart")}>
                {t.autostart}
              </span>
              <button
                type="button"
                role="switch"
                class="mac-switch"
                aria-checked={checked(d.autostart)}
                aria-label={t.autostart}
                data-setting="autostart"
              >
                <i></i>
              </button>
            </div>
            <div class="settings-row">
              <span class="settings-label" {...tx("language")}>
                {t.language}
              </span>
              <select class="mac-select" aria-label={t.language} data-label="language" data-language>
                <option value="auto" {...tx("languageAuto")}>{t.languageAuto}</option>
                {settingsLanguages.map(({ value, label }) => (
                  <option value={value} selected={value === "en"} dir="auto">{label}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="settings-card">
            <div class="settings-row">
              <span class="settings-text">
                <span class="settings-label" {...tx("updates")}>
                  {t.updates}
                </span>
                <span class="settings-hint" data-update-status aria-live="polite">
                  {t.updatesCurrent}
                </span>
              </span>
              <button type="button" class="mac-button" data-update {...tx("updatesCheck")}>
                {t.updatesCheck}
              </button>
            </div>
            <ToggleRow name="autoUpdate" hint="autoUpdateHint" on={d.autoUpdate} />
          </div>
        </div>
      </div>
    </div>

    <div class="preview" data-preview aria-label="Live preview of the dock" role="img">
      <Image
        src={wallpaper}
        alt=""
        class="preview-wall"
        widths={[480, 960]}
        sizes="(min-width: 1024px) 480px, 100vw"
      />
      <div class="preview-bar" data-preview-bar>
        <b>Muelle</b>
        <span class="preview-island" data-preview-island aria-hidden="true">
          <i style="--ring: #d97757; --p: 63%"></i>63%
          <i style="--ring: #8ab4f8; --p: 28%"></i>28%
        </span>
        <span class="preview-bar-status">
          <MenuBarStatus compact accessoryPreview />
          <span class="hidden sm:inline" data-date>
            Fri, Nov 14
          </span>
          <span class="tabular-nums" data-clock>
            9:41 AM
          </span>
        </span>
      </div>
      <div class="preview-dock" data-preview-dock>
        <span class="preview-start" data-preview-icon data-fixed="showStart" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M2 2h9v9H2zm11 0h9v9h-9zM2 13h9v9H2zm11 0h9v9h-9z" />
          </svg>
        </span>
        {previewDockItems.map(({ icon, fixed }) => (
          <Image src={icon} alt="" class="w-32" data-preview-icon data-fixed={fixed} />
        ))}
      </div>
      <Crab cell={2} class="crab-free" data-preview-crab />
    </div>

    <script type="application/json" is:inline data-settings-text set:html={textJson} />
  </div>
</Section>

<script>
  import { initPreviewCrab } from "@/scripts/crab-spots";
  import { initCustomize } from "@/scripts/customize";
  import { initReveal } from "@/scripts/reveal";
  import { initClock } from "@/scripts/clock";

  const section = document.querySelector<HTMLElement>("#customize");
  if (section) {
    initReveal(section);
    initCustomize(section);
    initPreviewCrab(section);
  }
  initClock();
</script>
