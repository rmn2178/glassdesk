---
import Crab from "@/components/crab/Crab.astro";
import CursorOverlay from "@/components/dock/CursorOverlay.astro";
import DesktopWallpaper from "@/components/dock/DesktopWallpaper.astro";
import DockDemo from "@/components/dock/DockDemo.astro";
import MenuBarMock from "@/components/dock/MenuBarMock.astro";
import NotesWindow from "@/components/dock/NotesWindow.astro";
import "@/styles/dock.css";
---

<div class="window">
  <div class="desk">
    <DesktopWallpaper />

    <MenuBarMock />

    <div class="absolute inset-x-0 top-[12%] z-2 flex justify-center px-4">
      <div class="h-[clamp(230px,26vw,340px)] w-full max-w-[560px]">
        <NotesWindow />
      </div>
    </div>

    <CursorOverlay class="top-0 left-0 opacity-0" />

    <canvas
      data-genie
      class="genie-canvas pointer-events-none absolute inset-0 z-2 hidden"
      aria-hidden="true"
    >
    </canvas>

    <div class="absolute inset-x-0 bottom-3 z-5">
      <DockDemo />
    </div>

    <Crab
      cell={2.5}
      class="crab-free"
      interactive
      label="Muelle's crab. Click it to see how it feels."
      tip="Click me"
      data-hero-crab
    />
  </div>
</div>

<script>
  import { prefersReducedMotion } from "@/lib/motion";
  import { initGenie } from "@/scripts/genie";
  import { initHeroCrab } from "@/scripts/hero-crab";

  const stage = document.querySelector<HTMLElement>(".desk");
  if (stage) {
    initGenie(stage, prefersReducedMotion());
    initHeroCrab(stage);
  }
</script>
