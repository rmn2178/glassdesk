---
import Icon from "@/components/ui/Icon.astro";

interface Props { compact?: boolean; accessoryPreview?: boolean }
const { compact = false, accessoryPreview = false } = Astro.props;
---

<span class:list={["menu-status", compact && "menu-status-compact"]} aria-hidden="true">
  {!compact && <Icon name="widgets" size={13} class="hidden md:inline" />}
  {!compact && <Icon name="task-view" size={13} class="hidden sm:inline" />}
  {accessoryPreview && (
    <span class="accessory-status" data-preview-accessories hidden>
      <span><Icon name="mouse" size={12} /><span>76%</span></span>
      <span><Icon name="headset" size={12} /><span>58%</span></span>
    </span>
  )}
  <Icon name="battery" size={15} />
  <Icon name="volume" size={14} />
  <Icon name="wifi" size={14} />
  {!compact && <Icon name="search" size={14} class="hidden sm:inline" />}
  <Icon name="sliders" size={14} />
</span>

<style>
  .menu-status {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: clamp(7px, 1vw, 12px);
  }
  .menu-status-compact { gap: 6px; }
  .accessory-status { display: inline-flex; gap: 8px; font-variant-numeric: tabular-nums; cursor: default; }
  .accessory-status[hidden] { display: none; }
  .accessory-status > span { display: inline-flex; align-items: center; gap: 3px; }
</style>
