---
import { Image } from "astro:assets";
import type { DockItem } from "@/data/dock";

interface Props {
  item: DockItem;
}

const { item } = Astro.props;
---

<li class="dock-item">
  <Image
    src={item.icon}
    alt={item.label}
    class="size-full squircle-md"
  />
  <span class="dock-tip" aria-hidden="true">{item.label}</span>
  {item.open && <i class="dock-dot" aria-hidden="true" />}
</li>
