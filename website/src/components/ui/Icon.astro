---
import type { IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <use href={`#icon-${name}`} />
</svg>
