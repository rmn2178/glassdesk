---
import { Image } from "astro:assets";
import logo from "@/assets/brand/muelle-logo.webp";
import Container from "@/components/layout/Container.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { navigation } from "@/data/navigation";
import { site } from "@/data/site";
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-xl">
  <Container class="flex h-14 items-center justify-between gap-4">
    <a href="/" aria-label={`${site.name} home`} class="flex shrink-0 items-center">
      <Image src={logo} alt={site.name} class="w-50" />
    </a>

    <nav
      aria-label="Main navigation"
      class="hidden items-center gap-7 font-mono text-[12px] tracking-[0.08em] text-mute uppercase lg:flex"
    >
      {
        navigation.map(({ label, href }) => (
          <a
            href={href}
            class="transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={site.repository}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${site.name} on GitHub`}
        class="squircle-pill p-2 text-fg/80 transition-colors hover:bg-card hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <Icon name="github" size={20} />
      </a>
      <Button href={site.download} size="sm" class="ml-1 max-sm:hidden">
        Download
        <Icon name="arrow-right" size={16} />
      </Button>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="ml-1 squircle-pill p-2 text-fg transition-colors hover:bg-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary lg:hidden"
      >
        <Icon name="menu" size={20} class="icon-menu" />
        <Icon name="close" size={20} class="icon-close hidden" />
      </button>
    </div>
  </Container>

  <div id="mobile-menu" hidden class="border-t border-line lg:hidden">
    <Container class="flex flex-col gap-1 py-4">
      {
        navigation.map(({ label, href }) => (
          <a
            href={href}
            class="squircle-sm px-2 py-2.5 font-mono text-[12px] tracking-[0.08em] text-mute uppercase transition-colors hover:bg-card hover:text-fg"
          >
            {label}
          </a>
        ))
      }
      <Button href={site.download} class="mt-3">
        Download for Windows
        <Icon name="arrow-right" size={18} />
      </Button>
    </Container>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const panel = document.querySelector<HTMLElement>("#mobile-menu");
  const menuIcon = button?.querySelector<SVGElement>(".icon-menu");
  const closeIcon = button?.querySelector<SVGElement>(".icon-close");

  if (button && panel) {
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
      menuIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };

    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    // Anchors navigate away from the panel, so it must not stay open behind them.
    panel.addEventListener("click", (event) => {
      // The click can land on an icon inside the link, so look for the closest anchor.
      if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
