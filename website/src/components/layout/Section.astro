---
import Container from "@/components/layout/Container.astro";

interface Props {
  id?: string;
  /** The landing gives every section the same top padding; the hero opts out. */
  spacing?: boolean;
  class?: string;
}

const { id, spacing = true, class: className } = Astro.props;
---

<section id={id} class:list={[spacing && "pt-[140px]", className]}>
  <Container>
    <slot />
  </Container>
</section>
