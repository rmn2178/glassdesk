{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nosih",
  "identifier": "app.nosih.settings",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Nosih",
        "width": 780,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNEYxOUVEODA3QTI1RDkKUldUWkpYcUE3UmxQSTdLMCtDWW5oT2o2NWVtL0cwUnorMWdsOStGMGlwMmNsNEczS1Nldlo1L0UK",
      "endpoints": [
        "https://github.com/nosih-app/nosih/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
